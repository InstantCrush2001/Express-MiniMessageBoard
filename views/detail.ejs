<html>
  <head>
    <title><%= title %></title>
</head>
<body>
<main>
  <h1>Mini Message Board</h1>
    <div class="detail-container">
      <p class="detail-name"><%= message.username %></p>
      <p class="detail-date"><%= typeof message.added === "string" ? message.added : message.added.toLocaleString('ja-JP', { dateStyle: 'medium', timeStyle: 'long', timeZone: 'Asia/Tokyo' }) %></p>
      <p class="detail-message">"<%= message.message %>"</p>
      <a href="/">Back</a>
    </div>
</main>
</body>
</html>
